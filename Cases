<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
/* ==========================================================================
   إعداد الاتصال بالخادم — ضع رابط Google Apps Script Web App هنا
   ========================================================================== */
var WEB_APP_URL = "https://script.google.com/macros/s/AKfycbwFu-LuqmkaaM2sTrgEsxtN6Mmepixnug4VvaoxRX7qFB6iAnbA91ruYVcwqHkKHBqsAg/exec";

/* ==========================================================================
   الوضع الليلي / النهاري
   ========================================================================== */
function applyThemeUI(theme){
  var isDark = theme === 'dark';
  var loginBtn = $('themeToggleLogin');
  if (loginBtn) loginBtn.textContent = isDark ? '☀️' : '🌙';
  var icon = $('themeIcon'), label = $('themeLabel');
  if (icon) icon.textContent = isDark ? '☀️' : '🌙';
  if (label) label.textContent = isDark ? 'الوضع النهاري' : 'الوضع الليلي';
}
function initTheme(){
  var saved = localStorage.getItem('bo_theme');
  var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  document.documentElement.setAttribute('data-theme', theme);
  applyThemeUI(theme);
}
function toggleTheme(){
  var current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  var next = current === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  try { localStorage.setItem('bo_theme', next); } catch(e){}
  applyThemeUI(next);
}
initTheme();

/* ==========================================================================
   الحالة العامة للتطبيق
   ========================================================================== */
var STATE = {
  token: null, role: null, username: null, fullName: null,
  meta: { categories: [], problemTypes: [], statuses: [], priorities: [] },
  cases: [], reminders: [], reminderTab: 'today', adminTab: 'users', metaLoaded: false, currentView: 'dashboard'
};

/* ==========================================================================
   أدوات مساعدة عامة
   ========================================================================== */
function $(id){ return document.getElementById(id); }
function digitsOnly(el, maxLen){
  var cleaned = el.value.replace(/[^0-9]/g, '').slice(0, maxLen);
  if (cleaned !== el.value) el.value = cleaned;
}
function esc(s){ return String(s===undefined||s===null?'':s).replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
function toast(msg, type){
  var t = document.createElement('div');
  t.className = 'toast' + (type==='err'?' err':type==='ok'?' ok':'');
  t.textContent = msg;
  $('toastWrap').appendChild(t);
  setTimeout(function(){ t.remove(); }, 3500);
}
function openModal(id){ $(id).classList.add('show'); }
function closeModal(id){ $(id).classList.remove('show'); }

function api(action, payload){
  payload = payload || {};
  payload.action = action;
  if (STATE.token) payload.token = STATE.token;
  if (!WEB_APP_URL || WEB_APP_URL.indexOf('http') !== 0){
    return Promise.reject(new Error('لم يتم ضبط رابط Google Apps Script داخل الملف بعد (WEB_APP_URL).'));
  }
  return fetch(WEB_APP_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' }, // لتجنب CORS preflight
    body: JSON.stringify(payload)
  }).then(function(r){ return r.json(); }).then(function(res){
    if (!res.success) throw new Error(res.message || 'حدث خطأ غير متوقع');
    return res;
  });
}

/* ==========================================================================
   تسجيل الدخول / الخروج
   ========================================================================== */
function doLogin(){
  var username = $('loginUsername').value.trim();
  var password = $('loginPassword').value;
  $('loginError').style.display = 'none';
  if (!username || !password){ showLoginError('الرجاء إدخال اسم المستخدم وكلمة المرور'); return; }
  var btn = $('loginBtn'); btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>';
  api('login', { username: username, password: password }).then(function(res){
    STATE.token = res.token; STATE.role = res.role; STATE.username = res.username; STATE.fullName = res.fullName;
    sessionStorage.setItem('bo_session', JSON.stringify({token:res.token, role:res.role, username:res.username, fullName:res.fullName}));
    enterApp();
  }).catch(function(err){ showLoginError(err.message); }).finally(function(){ btn.disabled=false; btn.innerHTML='تسجيل الدخول'; });
}
function showLoginError(msg){ var e=$('loginError'); e.textContent = msg; e.style.display='block'; }
function doLogout(){
  sessionStorage.removeItem('bo_session');
  STATE.token = null;
  location.reload();
}
// محاولة استعادة الجلسة من التبويب الحالي (بدون تخزين كلمة المرور)
(function tryRestoreSession(){
  var raw = sessionStorage.getItem('bo_session');
  if (!raw) return;
  try {
    var s = JSON.parse(raw);
    STATE.token = s.token; STATE.role = s.role; STATE.username = s.username; STATE.fullName = s.fullName;
  } catch(e){}
})();

function enterApp(){
  $('loginScreen').style.display = 'none';
  if ($('themeToggleLogin')) $('themeToggleLogin').style.display = 'none';
  $('appShell').style.display = 'grid';
  $('sidebarFullName').textContent = STATE.fullName;
  $('sidebarRole').textContent = STATE.role === 'admin' ? 'مدير النظام' : 'موظف';
  $('avatarInitial').textContent = (STATE.fullName||'?').trim().charAt(0);
  buildNav();
  loadMetaAndData();
}

/* ==========================================================================
   بناء القائمة الجانبية والتنقل
   ========================================================================== */
var NAV_ITEMS = [
  { id:'dashboard', label:'لوحة التحكم', ic:'🏠' },
  { id:'newcase', label:'حالة جديدة', ic:'➕' },
  { id:'cases', label:'الحالات', ic:'📋' },
  { id:'reminders', label:'التذكيرات', ic:'⏰' },
  { id:'account', label:'الحساب', ic:'👤' }
];
function buildNav(){
  var html = '';
  NAV_ITEMS.forEach(function(n){
    html += '<div class="nav-item" data-v="'+n.id+'" onclick="showView(\''+n.id+'\')"><span class="ic">'+n.ic+'</span>'+n.label+'</div>';
  });
  if (STATE.role === 'admin'){
    html += '<div class="nav-sep"></div><div class="nav-group-title">الإدارة</div>';
    html += '<div class="nav-item" data-v="reports" onclick="showView(\'reports\')"><span class="ic">📄</span>التقارير</div>';
    html += '<div class="nav-item" data-v="admin" onclick="showView(\'admin\')"><span class="ic">🛠️</span>لوحة الإدارة</div>';
  }
  $('navItems').innerHTML = html;
  showView('dashboard');
}
function showView(id){
  STATE.currentView = id;
  document.querySelectorAll('.view').forEach(function(v){ v.classList.remove('active'); });
  document.querySelectorAll('.nav-item').forEach(function(n){ n.classList.remove('active'); });
  $('view-'+id).classList.add('active');
  var nav = document.querySelector('.nav-item[data-v="'+id+'"]'); if (nav) nav.classList.add('active');
  toggleSidebar(false);
  if (id === 'dashboard') renderDashboard();
  if (id === 'newcase') renderNewCaseForm();
  if (id === 'cases') renderCasesTable();
  if (id === 'reminders') renderReminders();
  if (id === 'admin') renderAdmin();
  if (id === 'reports') renderReportsView();
}
function toggleSidebar(open){
  $('sidebar').classList.toggle('open', !!open);
  $('overlay').classList.toggle('show', !!open);
}

/* ==========================================================================
   تحميل البيانات الأساسية
   ========================================================================== */
function loadMetaAndData(){
  Promise.all([ api('getMeta'), api('listCases'), api('listReminders') ]).then(function(res){
    STATE.meta = res[0];
    STATE.cases = res[1].cases;
    STATE.reminders = res[2].reminders;
    STATE.metaLoaded = true;
    refreshActiveView();
  }).catch(function(err){ toast('تعذّر تحميل البيانات: ' + err.message, 'err'); });
}
// يعيد عرض القسم المفتوح حالياً — يُستدعى بعد وصول بيانات الخادم حتى لا تبقى القوائم فارغة
// إذا فتح المستخدم قسماً قبل انتهاء التحميل
function refreshActiveView(){
  showView(STATE.currentView || 'dashboard');
}
function refreshCases(){ return api('listCases').then(function(res){ STATE.cases = res.cases; }); }
function refreshReminders(){ return api('listReminders').then(function(res){ STATE.reminders = res.reminders; }); }
function refreshMetaOnly(){ return api('getMeta').then(function(res){ STATE.meta = res; STATE.metaLoaded = true; }); }

/* ==========================================================================
   لوحة التحكم
   ========================================================================== */
function renderDashboard(){
  var cases = STATE.cases || [];
  var open = cases.filter(function(c){ return c.Status !== 'مغلقة'; }).length;
  var todayStr = new Date().toISOString().slice(0,10);
  var createdToday = cases.filter(function(c){ return c.CreatedDate === todayStr; }).length;
  var rem = STATE.reminders || [];
  var overdueCount = rem.filter(isOverdue).length;
  $('dashStats').innerHTML =
    statCard(cases.length, 'إجمالي الحالات') +
    statCard(open, 'حالات مفتوحة') +
    statCard(createdToday, 'حالات اليوم') +
    statCard(overdueCount, 'تذكيرات متأخرة');
  var recent = cases.slice(0, 8);
  $('dashRecentTable').innerHTML = casesTableHtml(recent, false);
}
function statCard(n, l){ return '<div class="stat-card accent"><div class="n">'+n+'</div><div class="l">'+l+'</div></div>'; }

/* ==========================================================================
   حالة جديدة
   ========================================================================== */
function renderNewCaseForm(){
  var now = new Date();
  $('newCaseAutoFields').innerHTML =
    field('Case ID', 'سيتم توليده تلقائياً بعد الحفظ') +
    field('التاريخ', now.toLocaleDateString('ar-EG-u-nu-latn')) +
    field('الوقت', now.toLocaleTimeString('ar-EG-u-nu-latn')) +
    field('الموظف', STATE.fullName);

  if (!STATE.metaLoaded){
    var loadingOpt = '<option value="">جارٍ تحميل القوائم من الخادم...</option>';
    $('ncCategory').innerHTML = loadingOpt;
    $('ncProblemType').innerHTML = loadingOpt;
    $('ncPriority').innerHTML = loadingOpt;
    $('ncStatus').innerHTML = loadingOpt;
    $('ncSubmitBtn').disabled = true;
    return; // سيُعاد استدعاء هذه الدالة تلقائياً فور وصول البيانات (انظر refreshActiveView)
  }
  $('ncSubmitBtn').disabled = false;
  var catSel = $('ncCategory');
  catSel.innerHTML = '<option value="">اختر...</option>' + STATE.meta.categories.map(function(c){ return '<option>'+esc(c)+'</option>'; }).join('');
  $('ncPriority').innerHTML = STATE.meta.priorities.map(function(p){ return '<option>'+esc(p)+'</option>'; }).join('');
  $('ncStatus').innerHTML = STATE.meta.statuses.map(function(s){ return '<option>'+esc(s)+'</option>'; }).join('');
  onCategoryChange();
  // تفريغ الحقول
  ['ncSubscriberName','ncPhone','ncContractID','ncOLT','ncFDT','ncFAT','ncPort','ncDescription','ncActionTaken','ncNotes'].forEach(function(id){ $(id).value=''; });
}
function field(label, value){ return '<div class="field"><label>'+label+'</label><input type="text" value="'+esc(value)+'" disabled></div>'; }
function onCategoryChange(){
  var cat = $('ncCategory').value;
  var types = STATE.meta.problemTypes.filter(function(p){ return !cat || p.Category === cat; });
  $('ncProblemType').innerHTML = '<option value="">اختر...</option>' + types.map(function(p){ return '<option>'+esc(p.Name)+'</option>'; }).join('');
  onProblemTypeChange();
}
function onProblemTypeChange(){
  var name = $('ncProblemType').value;
  var pt = STATE.meta.problemTypes.filter(function(p){ return p.Name === name; })[0];
  var fields = (pt && pt.CustomFields) ? pt.CustomFields : [];
  $('ncCustomFields').innerHTML = fields.map(function(f, i){
    return '<div class="field"><label>'+esc(f)+'</label><input type="text" class="cf-input" data-label="'+esc(f)+'"></div>';
  }).join('');
}
function submitNewCase(){
  var category = $('ncCategory').value, problemType = $('ncProblemType').value;
  if (!category || !problemType){ toast('الرجاء اختيار Category و Problem Type', 'err'); return; }
  var customFields = {};
  document.querySelectorAll('#ncCustomFields .cf-input').forEach(function(inp){ customFields[inp.dataset.label] = inp.value; });
  var caseData = {
    Category: category, ProblemType: problemType,
    Priority: $('ncPriority').value, Status: $('ncStatus').value,
    SubscriberName: $('ncSubscriberName').value, Phone: $('ncPhone').value,
    ContractID: $('ncContractID').value, OLT: $('ncOLT').value, FDT: $('ncFDT').value,
    FAT: $('ncFAT').value, Port: $('ncPort').value, Description: $('ncDescription').value,
    ActionTaken: $('ncActionTaken').value, Notes: $('ncNotes').value, CustomFields: customFields
  };
  var btn = $('ncSubmitBtn'); btn.disabled = true; btn.textContent = 'جارِ الحفظ...';
  api('createCase', { caseData: caseData }).then(function(res){
    toast('تم إنشاء الحالة برقم ' + res.caseId, 'ok');
    var now = new Date();
    var localRecord = Object.assign({
      CaseID: res.caseId,
      CreatedDate: now.toISOString().slice(0,10),
      CreatedTime: now.toTimeString().slice(0,8),
      CreatedBy: STATE.username,
      CreatedByName: STATE.fullName,
      LastUpdated: now,
      LastUpdatedBy: STATE.username
    }, caseData);
    STATE.cases.unshift(localRecord);
    renderNewCaseForm();
    showView('cases');
  })
  .catch(function(err){ toast(err.message, 'err'); })
  .finally(function(){ btn.disabled=false; btn.textContent='حفظ الحالة'; });
}

/* ==========================================================================
   الحالات
   ========================================================================== */
function ensureCaseFilters(){
  var sSel = $('casesFilterStatus'), pSel = $('casesFilterPriority');
  if (sSel.options.length <= 1){ STATE.meta.statuses.forEach(function(s){ sSel.innerHTML += '<option>'+esc(s)+'</option>'; }); }
  if (pSel.options.length <= 1){ STATE.meta.priorities.forEach(function(p){ pSel.innerHTML += '<option>'+esc(p)+'</option>'; }); }
}
function statusBadgeClass(status){
  if (status === 'مغلقة') return 'badge-success';
  if (status === 'قيد المعالجة') return 'badge-info';
  if (status === 'بانتظار المشترك' || status === 'بانتظار قسم آخر') return 'badge-warning';
  return 'badge-muted';
}
function priorityBadgeClass(p){
  if (p === 'عالية') return 'badge-danger';
  if (p === 'متوسطة') return 'badge-warning';
  return 'badge-muted';
}
function casesTableHtml(list, withActions){
  if (!list.length) return '<tr><td class="empty-state">لا توجد حالات لعرضها 📭</td></tr>';
  var head = '<tr><th>Case ID</th><th>التاريخ</th><th>المشترك</th><th>User Name</th><th>Problem Type</th><th>Priority</th><th>Status</th><th>الموظف</th>'+(withActions!==false?'<th></th>':'')+'</tr>';
  var rows = list.map(function(c){
    return '<tr>'+
      '<td><b>'+esc(c.CaseID)+'</b></td>'+
      '<td>'+esc(c.CreatedDate)+'</td>'+
      '<td>'+esc(c.SubscriberName||'—')+'</td>'+
      '<td>'+esc(c.OLT||'—')+'</td>'+
      '<td>'+esc(c.ProblemType)+'</td>'+
      '<td><span class="badge '+priorityBadgeClass(c.Priority)+'">'+esc(c.Priority)+'</span></td>'+
      '<td><span class="badge '+statusBadgeClass(c.Status)+'">'+esc(c.Status)+'</span></td>'+
      '<td>'+esc(c.CreatedByName)+'</td>'+
      (withActions!==false ? '<td><button class="btn btn-outline btn-sm" onclick="openEditCase(\''+esc(c.CaseID)+'\')">فتح</button></td>' : '')+
    '</tr>';
  }).join('');
  return head + rows;
}
function renderCasesTable(){
  ensureCaseFilters();
  var q = ($('casesSearch').value || '').trim().toLowerCase();
  var fStatus = $('casesFilterStatus').value, fPriority = $('casesFilterPriority').value;
  var list = (STATE.cases||[]).filter(function(c){
    if (fStatus && c.Status !== fStatus) return false;
    if (fPriority && c.Priority !== fPriority) return false;
    if (q){
      var hay = [c.CaseID, c.SubscriberName, c.Phone, c.ContractID, c.ProblemType].join(' ').toLowerCase();
      if (hay.indexOf(q) === -1) return false;
    }
    return true;
  });
  $('casesTable').innerHTML = casesTableHtml(list, true);
}
function openEditCase(caseId){
  var c = STATE.cases.filter(function(x){ return x.CaseID === caseId; })[0];
  if (!c) return;
  $('editCaseTitle').textContent = 'تعديل الحالة ' + c.CaseID;
  var statusOpts = STATE.meta.statuses.map(function(s){ return '<option '+(s===c.Status?'selected':'')+'>'+esc(s)+'</option>'; }).join('');
  var prioOpts = STATE.meta.priorities.map(function(p){ return '<option '+(p===c.Priority?'selected':'')+'>'+esc(p)+'</option>'; }).join('');
  $('editCaseBody').innerHTML =
    '<div class="grid grid-2">'+
      '<div class="field"><label>Status</label><select id="ecStatus">'+statusOpts+'</select></div>'+
      '<div class="field"><label>Priority</label><select id="ecPriority">'+prioOpts+'</select></div>'+
    '</div>'+
    '<div class="field"><label>الإجراء المتخذ</label><textarea id="ecActionTaken" rows="2">'+esc(c.ActionTaken)+'</textarea></div>'+
    '<div class="field"><label>ملاحظات</label><textarea id="ecNotes" rows="2">'+esc(c.Notes)+'</textarea></div>'+
    '<div class="hint">Category: '+esc(c.Category)+' • Problem Type: '+esc(c.ProblemType)+' • المشترك: '+esc(c.SubscriberName||'—')+' • الهاتف: '+esc(c.Phone||'—')+'</div>'+
    '<button class="btn btn-outline btn-sm" style="margin-top:14px;" onclick="prefillReminderFor(\''+esc(c.CaseID)+'\')">➕ إضافة تذكير لهذه الحالة</button>';
  $('editCaseBody').dataset.caseId = caseId;
  openModal('editCaseModal');
}
function saveEditCase(){
  var caseId = $('editCaseBody').dataset.caseId;
  var updates = { Status: $('ecStatus').value, Priority: $('ecPriority').value, ActionTaken: $('ecActionTaken').value, Notes: $('ecNotes').value };
  var saveBtn = document.querySelector('#editCaseModal .btn-primary');
  if (saveBtn){ saveBtn.disabled = true; saveBtn.textContent = 'جارِ الحفظ...'; }
  api('updateCase', { caseId: caseId, updates: updates }).then(function(){
    toast('تم حفظ التعديلات', 'ok');
    closeModal('editCaseModal');
    var idx = STATE.cases.findIndex(function(c){ return c.CaseID === caseId; });
    if (idx > -1) Object.assign(STATE.cases[idx], updates, { LastUpdated: new Date(), LastUpdatedBy: STATE.username });
    renderCasesTable(); renderDashboard();
  }).catch(function(err){ toast(err.message, 'err'); })
  .finally(function(){ if (saveBtn){ saveBtn.disabled = false; saveBtn.textContent = 'حفظ التعديلات'; } });
}
function prefillReminderFor(caseId){
  closeModal('editCaseModal');
  $('remCaseId').value = caseId;
  openModal('addReminderModal');
}
function exportCasesCsv(){
  var cols = ['CaseID','CreatedDate','CreatedTime','CreatedByName','Category','ProblemType','Priority','Status','SubscriberName','Phone','ContractID','OLT','FDT','FAT','Port','Description','ActionTaken','Notes'];
  var lines = [cols.join(',')];
  (STATE.cases||[]).forEach(function(c){
    lines.push(cols.map(function(k){ return '"' + String(c[k]===undefined?'':c[k]).replace(/"/g,'""') + '"'; }).join(','));
  });
  var csv = '\uFEFF' + lines.join('\n');
  var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'Cases_' + new Date().toISOString().slice(0,10) + '.csv';
  a.click();
}

/* ==========================================================================
   التذكيرات
   ========================================================================== */
function parseDate(d){ return d ? new Date(d) : null; }
function isDoneReminder(r){ return r.ReminderStatus === 'مكتملة'; }
function isOverdue(r){
  if (isDoneReminder(r)) return false;
  var d = parseDate(r.DueDate || r.ReminderDate);
  if (!d) return false;
  var today = new Date(); today.setHours(0,0,0,0);
  return d < today;
}
function isToday(r){
  var d = parseDate(r.ReminderDate); if (!d) return false;
  var today = new Date().toISOString().slice(0,10);
  return (r.ReminderDate||'').slice(0,10) === today;
}
function isUpcoming(r){
  if (isDoneReminder(r) || isOverdue(r) || isToday(r)) return false;
  return true;
}
function setReminderTab(t){
  STATE.reminderTab = t;
  document.querySelectorAll('#reminderTabs .tab').forEach(function(el){ el.classList.toggle('active', el.dataset.t===t); });
  renderReminders();
}
function renderReminders(){
  var list = (STATE.reminders||[]).filter(function(r){
    if (STATE.reminderTab === 'today') return isToday(r) && !isDoneReminder(r);
    if (STATE.reminderTab === 'overdue') return isOverdue(r);
    if (STATE.reminderTab === 'upcoming') return isUpcoming(r);
    if (STATE.reminderTab === 'done') return isDoneReminder(r);
  });
  var addBtn = '<button class="btn btn-primary btn-sm" style="margin-bottom:14px;" onclick="openAddReminder()">➕ إضافة تذكير</button>';
  if (!list.length){ $('remindersList').innerHTML = addBtn + '<div class="card empty-state"><div class="ic">⏰</div>لا توجد تذكيرات في هذا القسم</div>'; return; }
  var html = list.map(function(r){
    return '<div class="reminder-item">'+
      '<div><div class="rt">'+esc(r.CaseID)+' — '+esc(r.ReminderType||'تذكير')+'</div><div class="rc">تاريخ: '+esc(r.ReminderDate)+(r.DueDate?' • استحقاق: '+esc(r.DueDate):'')+(r.Note?' • '+esc(r.Note):'')+'</div></div>'+
      (isDoneReminder(r) ? '<span class="badge badge-success">مكتملة</span>' : '<button class="btn btn-outline btn-sm" onclick="markReminderDone(\''+esc(r.ReminderID)+'\')">تمّت ✓</button>')+
    '</div>';
  }).join('');
  $('remindersList').innerHTML = addBtn + html;
}
function openAddReminder(){ $('remCaseId').value=''; $('remType').value=''; $('remDate').value=new Date().toISOString().slice(0,10); $('remDue').value=''; $('remNote').value=''; openModal('addReminderModal'); }
function submitReminder(){
  var caseId = $('remCaseId').value.trim();
  if (!caseId){ toast('الرجاء إدخال رقم الحالة', 'err'); return; }
  var reminder = { CaseID: caseId, ReminderType: $('remType').value, ReminderDate: $('remDate').value, DueDate: $('remDue').value, Note: $('remNote').value, ReminderStatus: 'قيد الانتظار' };
  var saveBtn = document.querySelector('#addReminderModal .btn-primary');
  if (saveBtn){ saveBtn.disabled = true; saveBtn.textContent = 'جارِ الحفظ...'; }
  api('addReminder', { reminder: reminder }).then(function(res){
    toast('تم إضافة التذكير', 'ok');
    closeModal('addReminderModal');
    reminder.ReminderID = res.reminderId; reminder.CreatedBy = STATE.username; reminder.CreatedAt = new Date();
    STATE.reminders.push(reminder);
    renderReminders(); renderDashboard();
  }).catch(function(err){ toast(err.message, 'err'); })
  .finally(function(){ if (saveBtn){ saveBtn.disabled=false; saveBtn.textContent='حفظ التذكير'; } });
}
function markReminderDone(reminderId){
  api('updateReminder', { reminderId: reminderId, updates: { ReminderStatus: 'مكتملة' } }).then(function(){
    toast('تم تحديث حالة التذكير', 'ok');
    var r = STATE.reminders.find(function(x){ return x.ReminderID === reminderId; });
    if (r) r.ReminderStatus = 'مكتملة';
    renderReminders(); renderDashboard();
  }).catch(function(err){ toast(err.message, 'err'); });
}

