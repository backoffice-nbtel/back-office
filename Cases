  api('changePassword', { oldPassword: oldP, newPassword: newP }).then(function(){
    toast('تم تحديث كلمة المرور بنجاح', 'ok'); $('accOldPass').value=''; $('accNewPass').value='';
  }).catch(function(err){ toast(err.message, 'err'); });
}

