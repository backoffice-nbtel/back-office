<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>National Bird Telecom — Back Office</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --primary:#F2670D;
    --primary-dark:#D9560A;
    --primary-light:#FDE7D6;
    --dark:#221F1C;
    --heading:#221F1C;
    --bg:#FAF9F6;
    --surface:#FFFFFF;
    --input-bg:#FFFFFF;
    --hover-row:#FBF8F4;
    --border:#E7E2DA;
    --text:#2A2A28;
    --muted:#8A857C;
    --success:#2F9E44;
    --success-bg:#E9F7EC;
    --danger:#E03131;
    --danger-bg:#FDECEC;
    --warning:#E8890C;
    --warning-bg:#FDF1DF;
    --info:#1971C2;
    --info-bg:#E7F2FC;
    --radius:10px;
    --shadow:0 1px 2px rgba(30,25,15,.06), 0 4px 14px rgba(30,25,15,.05);
  }
  :root{ --badge-muted-bg:#EFECE6; }
  html[data-theme="dark"]{ --badge-muted-bg:#2C2822; }
  html[data-theme="dark"]{
    --primary-light:#3A2A18;
    --dark:#0F0E0C;
    --heading:#FBF9F6;
    --bg:#15130F;
    --surface:#1E1B17;
    --input-bg:#26221C;
    --hover-row:rgba(255,255,255,.035);
    --border:#38332B;
    --text:#EEEAE2;
    --muted:#A39C8F;
    --success-bg:#153524;
    --danger-bg:#3A1E1D;
    --warning-bg:#3A2C10;
    --info-bg:#132A3D;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 4px 16px rgba(0,0,0,.35);
  }
  body, .card, .stat-card, input, select, textarea, .modal, .sidebar, .reminder-item{ transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:'Cairo',Tahoma,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  button,input,select,textarea{font-family:inherit; font-size:inherit;}
  ::selection{background:var(--primary-light);}

  /* ---------- شاشة الدخول ---------- */
  #loginScreen{
    min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px;
    background:radial-gradient(1200px 600px at 85% -10%, var(--login-glow,#FFE7CF) 0%, transparent 60%), var(--bg);
  }
  html[data-theme="dark"]{ --login-glow:#3A2413; }
  .login-card{
    width:100%; max-width:400px; background:var(--surface); border:1px solid var(--border);
    border-radius:16px; box-shadow:var(--shadow); padding:36px 32px;
  }
  .login-logo{display:flex; justify-content:center; margin-bottom:18px;}
  .login-logo img{height:52px;}
  .login-card h1{font-size:18px; text-align:center; margin:0 0 4px; color:var(--heading);}
  .login-card p.sub{text-align:center; color:var(--muted); font-size:13.5px; margin:0 0 26px;}
  .field{margin-bottom:16px;}
  .field label{display:block; font-size:13px; color:var(--muted); margin-bottom:6px; font-weight:600;}
  .field input, .field select, .field textarea{
    width:100%; padding:11px 13px; border:1.5px solid var(--border); border-radius:9px;
    background:var(--input-bg); color:var(--text); outline:none; transition:border-color .15s;
  }
  .field input:focus, .field select:focus, .field textarea:focus{border-color:var(--primary);}
  .field input:disabled{ color:var(--muted); opacity:1; -webkit-text-fill-color:var(--muted); }
  ::placeholder{ color:var(--muted); opacity:.85; }
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    border:none; border-radius:9px; padding:11px 18px; font-weight:700; font-size:14px;
    cursor:pointer; transition:filter .15s, transform .05s;
  }
  .btn:active{transform:translateY(1px);}
  .btn-primary{background:var(--primary); color:#fff;}
  .btn-primary:hover{filter:brightness(1.06);}
  .btn-block{width:100%;}
  .btn-outline{background:var(--surface); border:1.5px solid var(--border); color:var(--text);}
  .btn-outline:hover{border-color:var(--primary); color:var(--primary);}
  .btn-danger{background:var(--danger-bg); color:var(--danger);}
  .btn-sm{padding:7px 12px; font-size:12.5px; border-radius:7px;}
  .error-box{background:var(--danger-bg); color:var(--danger); border-radius:8px; padding:10px 12px; font-size:13px; margin-bottom:14px; display:none;}
  .spinner{width:16px; height:16px; border-radius:50%; border:2px solid rgba(255,255,255,.5); border-top-color:#fff; animation:spin .7s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  /* ---------- هيكل التطبيق ---------- */
  #appShell{display:none; min-height:100vh; grid-template-columns:230px 1fr;}
  @media(min-width:861px){ #appShell{display:grid;} }
  .sidebar{
    background:var(--dark); color:#fff; padding:20px 14px; display:flex; flex-direction:column;
    position:sticky; top:0; height:100vh;
  }
  .sidebar .brand{display:flex; align-items:center; gap:10px; padding:6px 8px 22px;}
  .sidebar .brand img{height:26px; background:#fff; border-radius:6px; padding:5px 8px;}
  .sidebar .brand span{font-weight:800; font-size:14.5px;}
  .nav-item{
    display:flex; align-items:center; gap:10px; padding:11px 12px; border-radius:9px; color:#D8D3CB;
    cursor:pointer; font-size:14px; font-weight:600; margin-bottom:3px; user-select:none;
  }
  .nav-item .ic{font-size:16px; width:20px; text-align:center;}
  .nav-item:hover{background:rgba(255,255,255,.06); color:#fff;}
  .nav-item.active{background:var(--primary); color:#fff;}
  .nav-sep{height:1px; background:rgba(255,255,255,.1); margin:12px 4px;}
  .nav-group-title{font-size:11px; color:#8A857C; padding:8px 12px 4px; font-weight:700;}
  .sidebar-footer{margin-top:auto; padding-top:14px;}
  .user-chip{display:flex; align-items:center; gap:9px; padding:10px; border-radius:9px; background:rgba(255,255,255,.06);}
  .user-avatar{width:32px; height:32px; border-radius:50%; background:var(--primary); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; flex-shrink:0;}
  .user-chip .u-name{font-size:13px; font-weight:700; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .user-chip .u-role{font-size:11px; color:#B8B3AB;}
  .logout-link{display:block; text-align:center; font-size:12.5px; color:#B8B3AB; margin-top:10px; cursor:pointer;}
  .logout-link:hover{color:#fff;}

  .topbar{
    display:none; align-items:center; justify-content:space-between; background:var(--surface);
    border-bottom:1px solid var(--border); padding:12px 16px; position:sticky; top:0; z-index:20;
  }
  @media(max-width:860px){ .topbar{display:flex;} #appShell{display:block;} .sidebar{position:fixed; inset-inline-start:0; top:0; bottom:0; width:230px; z-index:30; transform:translateX(105%); transition:transform .2s;} html[dir="rtl"] .sidebar.open{transform:translateX(0);} }
  .topbar .brand-mini{display:flex; align-items:center; gap:8px; font-weight:800; font-size:13.5px;}
  .topbar .brand-mini img{height:22px; background:#fff; border-radius:6px; padding:4px 6px;}
  .burger{background:none; border:none; font-size:20px; cursor:pointer; color:var(--heading);}
  .overlay{display:none; position:fixed; inset:0; background:rgba(0,0,0,.35); z-index:25;}
  .overlay.show{display:block;}

  .main{padding:22px 26px; max-width:1180px;}
  .view{display:none;}
  .view.active{display:block;}
  .view-header{display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; flex-wrap:wrap; gap:10px;}
  .view-header h2{margin:0; font-size:21px; color:var(--heading);}
  .view-header p{margin:2px 0 0; color:var(--muted); font-size:13.5px;}

  .grid{display:grid; gap:16px;}
  .grid-4{grid-template-columns:repeat(4,1fr);}
  .grid-2{grid-template-columns:repeat(2,1fr);}
  @media(max-width:900px){ .grid-4{grid-template-columns:repeat(2,1fr);} }
  @media(max-width:560px){ .grid-4,.grid-2{grid-template-columns:1fr;} }

  .stat-card{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:18px; box-shadow:var(--shadow);}
  .stat-card .n{font-size:26px; font-weight:800; color:var(--heading);}
  .stat-card .l{font-size:13px; color:var(--muted); margin-top:3px;}
  .stat-card.accent{border-inline-start:4px solid var(--primary);}

  .card{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:20px; box-shadow:var(--shadow); margin-bottom:18px;}
  .card h3{margin:0 0 14px; font-size:15.5px; color:var(--heading);}

  table{width:100%; border-collapse:collapse; font-size:13.5px;}
  th{text-align:start; color:var(--muted); font-weight:700; padding:9px 10px; border-bottom:2px solid var(--border); white-space:nowrap; font-size:12.5px;}
  td{padding:10px; border-bottom:1px solid var(--border); vertical-align:middle;}
  tr:hover td{background:var(--hover-row);}
  .table-wrap{overflow-x:auto;}
  .empty-state{text-align:center; padding:40px 20px; color:var(--muted);}
  .empty-state .ic{font-size:32px; margin-bottom:8px;}

  .badge{display:inline-block; padding:3px 10px; border-radius:999px; font-size:11.5px; font-weight:700; white-space:nowrap;}
  .badge-success{background:var(--success-bg); color:var(--success);}
  .badge-warning{background:var(--warning-bg); color:var(--warning);}
  .badge-danger{background:var(--danger-bg); color:var(--danger);}
  .badge-info{background:var(--info-bg); color:var(--info);}
  .badge-muted{background:var(--badge-muted-bg,#EFECE6); color:var(--muted);}

  .toolbar{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px; align-items:center;}
  .toolbar input, .toolbar select{padding:9px 12px; border:1.5px solid var(--border); border-radius:8px; background:var(--input-bg); color:var(--text);}
  .toolbar input[type=text]{min-width:220px; flex:1;}
  .tabs{display:flex; gap:6px; border-bottom:1.5px solid var(--border); margin-bottom:18px; flex-wrap:wrap;}
  .tab{padding:9px 14px; font-size:13.5px; font-weight:700; color:var(--muted); cursor:pointer; border-bottom:2.5px solid transparent; margin-bottom:-1.5px;}
  .tab.active{color:var(--primary); border-color:var(--primary);}

  .modal-bg{display:none; position:fixed; inset:0; background:rgba(20,17,12,.45); z-index:50; align-items:center; justify-content:center; padding:16px;}
  .modal-bg.show{display:flex;}
  .modal{background:var(--surface); border-radius:14px; width:100%; max-width:620px; max-height:88vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.25);}
  .modal-head{display:flex; align-items:center; justify-content:space-between; padding:18px 22px; border-bottom:1px solid var(--border); position:sticky; top:0; background:var(--surface);}
  .modal-head h3{margin:0; font-size:16px;}
  .modal-close{background:none; border:none; font-size:20px; cursor:pointer; color:var(--muted);}
  .modal-body{padding:20px 22px;}
  .modal-foot{padding:16px 22px; border-top:1px solid var(--border); display:flex; justify-content:flex-end; gap:10px;}

  .toast-wrap{position:fixed; bottom:20px; left:20px; z-index:90; display:flex; flex-direction:column; gap:8px;}
  .toast{background:var(--dark); color:#fff; padding:12px 18px; border-radius:9px; font-size:13.5px; box-shadow:var(--shadow); animation:toastIn .2s ease;}
  .toast.err{background:var(--danger);}
  .toast.ok{background:var(--success);}
  @keyframes toastIn{from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);}}

  .required:after{content:" *"; color:var(--danger);}
  .hint{font-size:12px; color:var(--muted); margin-top:4px;}
  .reminder-item{display:flex; justify-content:space-between; align-items:center; padding:12px 14px; border:1px solid var(--border); border-radius:9px; margin-bottom:9px; background:var(--surface);}
  .reminder-item .rt{font-size:13.5px; font-weight:700;}
  .reminder-item .rc{font-size:12px; color:var(--muted);}
  .row-actions{display:flex; gap:6px;}
  .config-warn{background:var(--warning-bg); color:#8A5A00; border:1px solid #F3D9A8; border-radius:9px; padding:12px 14px; font-size:13px; margin-bottom:16px;}
  .theme-toggle{
    position:fixed; top:18px; left:18px; z-index:60; width:40px; height:40px; border-radius:50%;
    border:1.5px solid var(--border); background:var(--surface); color:var(--text); font-size:17px;
    cursor:pointer; box-shadow:var(--shadow); display:flex; align-items:center; justify-content:center;
  }
  .theme-switch-row{
    display:flex; align-items:center; gap:8px; padding:9px 10px; border-radius:9px; color:#D8D3CB;
    font-size:12.5px; font-weight:600; cursor:pointer; margin-top:8px;
  }
  .theme-switch-row:hover{background:rgba(255,255,255,.06); color:#fff;}
</style>
</head>
<body>

<!-- ============ شاشة تسجيل الدخول ============ -->
<button class="theme-toggle" id="themeToggleLogin" onclick="toggleTheme()" title="تبديل الوضع الليلي/النهاري">🌙</button>
<div id="loginScreen">
  <div class="login-card">
    <div class="login-logo"><img src="data:image/png;base64," alt="National Bird Telecom"></div>
    <h1>نظام إدارة حالات Back Office</h1>
    <p class="sub">الرجاء تسجيل الدخول للمتابعة</p>
    <div class="error-box" id="loginError"></div>
    <div class="field">
      <label>اسم المستخدم</label>
      <input type="text" id="loginUsername" autocomplete="username" placeholder="اسم المستخدم">
    </div>
    <div class="field">
      <label>كلمة المرور</label>
      <input type="password" id="loginPassword" autocomplete="current-password" placeholder="••••••••">
    </div>
    <button class="btn btn-primary btn-block" id="loginBtn" onclick="doLogin()">تسجيل الدخول</button>
  </div>
</div>

<!-- ============ هيكل التطبيق ============ -->
<div id="appShell">
  <div class="overlay" id="overlay" onclick="toggleSidebar(false)"></div>
  <aside class="sidebar" id="sidebar">
    <div class="brand"><img src="data:image/png;base64," alt="logo"><span>Back Office</span></div>
    <div id="navItems"></div>
    <div class="sidebar-footer">
      <div class="user-chip">
        <div class="user-avatar" id="avatarInitial">-</div>
        <div>
          <div class="u-name" id="sidebarFullName">-</div>
          <div class="u-role" id="sidebarRole">-</div>
        </div>
      </div>
      <div class="theme-switch-row" onclick="toggleTheme()">
        <span id="themeIcon">🌙</span> <span id="themeLabel">الوضع الليلي</span>
      </div>
      <div class="logout-link" onclick="doLogout()">تسجيل الخروج ⏻</div>
    </div>
  </aside>

  <div>
    <div class="topbar">
      <button class="burger" onclick="toggleSidebar(true)">☰</button>
      <div class="brand-mini"><img src="data:image/png;base64," alt="logo">Back Office</div>
      <div></div>
    </div>

    <main class="main">

      <!-- لوحة التحكم -->
      <section class="view" id="view-dashboard">
        <div class="view-header"><div><h2>لوحة التحكم</h2><p>نظرة عامة سريعة على الحالات والتذكيرات</p></div></div>
        <div class="grid grid-4" id="dashStats"></div>
        <div class="card" style="margin-top:18px;">
          <h3>أحدث الحالات</h3>
          <div class="table-wrap"><table id="dashRecentTable"></table></div>
        </div>
      </section>

      <!-- حالة جديدة -->
      <section class="view" id="view-newcase">
        <div class="view-header"><div><h2>إنشاء حالة جديدة</h2><p>الحقول المطلوبة فقط مؤشر عليها بـ *</p></div></div>
        <div class="card">
          <div class="grid grid-2" id="newCaseAutoFields"></div>
        </div>
        <div class="card">
          <h3>تصنيف الحالة</h3>
          <div class="grid grid-2">
            <div class="field"><label class="required">Category</label><select id="ncCategory" onchange="onCategoryChange()"></select></div>
            <div class="field"><label class="required">Problem Type</label><select id="ncProblemType" onchange="onProblemTypeChange()"></select></div>
            <div class="field"><label class="required">Priority</label><select id="ncPriority"></select></div>
            <div class="field"><label class="required">Status</label><select id="ncStatus"></select></div>
          </div>
          <div class="grid grid-2" id="ncCustomFields"></div>
        </div>
        <div class="card">
          <h3>بيانات المشترك</h3>
          <div class="grid grid-2">
            <div class="field"><label>User Name</label><input type="text" id="ncOLT"></div>
            <div class="field"><label>اسم المشترك</label><input type="text" id="ncSubscriberName"></div>
            <div class="field"><label>رقم الهاتف</label><input type="text" id="ncPhone" inputmode="numeric" maxlength="11" oninput="digitsOnly(this,11)"></div>
            <div class="field"><label>Contract ID</label><input type="text" id="ncContractID" inputmode="numeric" maxlength="7" oninput="digitsOnly(this,7)"></div>
            <div class="field"><label>FDT</label><input type="text" id="ncFDT" inputmode="numeric" maxlength="2" oninput="digitsOnly(this,2)"></div>
            <div class="field"><label>FAT</label><input type="text" id="ncFAT" inputmode="numeric" maxlength="2" oninput="digitsOnly(this,2)"></div>
            <div class="field"><label>Port</label><input type="text" id="ncPort" inputmode="numeric" maxlength="2" oninput="digitsOnly(this,2)"></div>
          </div>
        </div>
        <div class="card">
          <h3>التفاصيل</h3>
          <div class="field"><label>الوصف</label><textarea id="ncDescription" rows="3"></textarea></div>
          <div class="field"><label>الإجراء المتخذ</label><textarea id="ncActionTaken" rows="2"></textarea></div>
          <div class="field"><label>ملاحظات</label><textarea id="ncNotes" rows="2"></textarea></div>
          <button class="btn btn-primary" onclick="submitNewCase()" id="ncSubmitBtn">حفظ الحالة</button>
        </div>
      </section>

      <!-- الحالات -->
      <section class="view" id="view-cases">
        <div class="view-header">
          <div><h2>الحالات</h2><p>جميع الحالات المسجلة في النظام</p></div>
          <button class="btn btn-outline btn-sm" onclick="exportCasesCsv()">تصدير Excel/CSV ⬇</button>
        </div>
        <div class="toolbar">
          <input type="text" id="casesSearch" placeholder="بحث برقم الحالة، اسم المشترك، الهاتف..." oninput="renderCasesTable()">
          <select id="casesFilterStatus" onchange="renderCasesTable()"><option value="">كل الحالات (Status)</option></select>
          <select id="casesFilterPriority" onchange="renderCasesTable()"><option value="">كل الأولويات</option></select>
        </div>
        <div class="card"><div class="table-wrap"><table id="casesTable"></table></div></div>
      </section>

      <!-- التذكيرات -->
      <section class="view" id="view-reminders">
        <div class="view-header"><div><h2>التذكيرات</h2><p>متابعة المهام والمواعيد المرتبطة بالحالات</p></div></div>
        <div class="tabs" id="reminderTabs">
          <div class="tab active" data-t="today" onclick="setReminderTab('today')">اليوم</div>
          <div class="tab" data-t="overdue" onclick="setReminderTab('overdue')">متأخرة</div>
          <div class="tab" data-t="upcoming" onclick="setReminderTab('upcoming')">قادمة</div>
          <div class="tab" data-t="done" onclick="setReminderTab('done')">مكتملة</div>
        </div>
        <div id="remindersList"></div>
      </section>

      <!-- الحساب -->
      <section class="view" id="view-account">
        <div class="view-header"><div><h2>الحساب</h2><p>بيانات حسابك وتغيير كلمة المرور</p></div></div>
        <div class="card" style="max-width:420px;">
          <h3>تغيير كلمة المرور</h3>
          <div class="field"><label>كلمة المرور الحالية</label><input type="password" id="accOldPass"></div>
          <div class="field"><label>كلمة المرور الجديدة</label><input type="password" id="accNewPass"></div>
          <button class="btn btn-primary" onclick="changeMyPassword()">تحديث كلمة المرور</button>
        </div>
      </section>

      <!-- التقارير (Admin فقط) -->
      <section class="view" id="view-reports">
        <div class="view-header"><div><h2>التقارير</h2><p>تقرير PDF شامل عن الحالات والتذكيرات وأداء الموظفين — للمدير فقط</p></div></div>
        <div class="card">
          <h3>تقرير النظام الشامل</h3>
          <p class="hint" style="margin-bottom:14px;">يتضمن: نظرة عامة على الأرقام، توزيع الحالات حسب Status/Priority/Category/Problem Type، أداء كل موظف، ملخص التذكيرات، وآخر عمليات سجل Audit Log.</p>
          <button class="btn btn-primary" id="genReportBtn" onclick="generatePdfReport()">📄 توليد وتنزيل تقرير PDF</button>
        </div>
      </section>

      <!-- الإدارة (Admin) -->
      <section class="view" id="view-admin">
        <div class="view-header"><div><h2>لوحة الإدارة</h2><p>إدارة الموظفين والقوائم والسجل</p></div></div>
        <div class="tabs" id="adminTabs">
          <div class="tab active" data-t="users" onclick="setAdminTab('users')">الموظفون</div>
          <div class="tab" data-t="categories" onclick="setAdminTab('categories')">Categories</div>
          <div class="tab" data-t="problemtypes" onclick="setAdminTab('problemtypes')">Problem Types</div>
          <div class="tab" data-t="statuses" onclick="setAdminTab('statuses')">Statuses</div>
