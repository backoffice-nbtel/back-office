function renderReportsView(){
  if (STATE.role !== 'admin'){ toast('هذه الصفحة متاحة للمدير فقط', 'err'); showView('dashboard'); return; }
}
function groupCount_(list, key){
  var map = {};
  list.forEach(function(item){ var k = item[key] || 'غير محدد'; map[k] = (map[k]||0) + 1; });
  return Object.keys(map).sort(function(a,b){ return map[b]-map[a]; }).map(function(k){ return { label: k, count: map[k] }; });
}
function reportTableRows_(pairs){
  return pairs.map(function(p){ return '<tr><td>'+esc(p.label)+'</td><td style="text-align:center;">'+p.count+'</td></tr>'; }).join('');
}
function buildReportHtml_(auditRows){
  var cases = STATE.cases || [], reminders = STATE.reminders || [];
  var open = cases.filter(function(c){ return c.Status !== 'مغلقة'; }).length;
  var closed = cases.length - open;
  var byStatus = groupCount_(cases, 'Status');
  var byPriority = groupCount_(cases, 'Priority');
  var byCategory = groupCount_(cases, 'Category');
  var byProblemType = groupCount_(cases, 'ProblemType');
  var byEmployee = groupCount_(cases, 'CreatedByName');
  var remToday = reminders.filter(isToday).length;
  var remOverdue = reminders.filter(isOverdue).length;
  var remUpcoming = reminders.filter(isUpcoming).length;
  var remDone = reminders.filter(isDoneReminder).length;
  var now = new Date();
  var stamp = now.toLocaleDateString('ar-EG-u-nu-latn') + ' — ' + now.toLocaleTimeString('ar-EG-u-nu-latn');

  var s = '<div dir="rtl" style="font-family:Cairo,Tahoma,Arial,sans-serif; color:#201F1C; background:#fff; width:760px; padding:28px;">';
  s += '<div style="display:flex; align-items:center; justify-content:space-between; border-bottom:3px solid #F2670D; padding-bottom:14px; margin-bottom:22px;">';
  s += '<div><div style="font-size:20px; font-weight:800;">تقرير النظام الشامل — Back Office</div><div style="font-size:12px; color:#8A857C; margin-top:4px;">National Bird Telecom</div></div>';
  s += '<div style="text-align:left; font-size:12px; color:#8A857C;">تاريخ التوليد<br><b style="color:#201F1C; font-size:13px;">'+esc(stamp)+'</b><br>بواسطة: '+esc(STATE.fullName)+'</div>';
  s += '</div>';

  function sectionTitle(t){ return '<div style="font-size:15px; font-weight:800; margin:22px 0 10px; padding-bottom:6px; border-bottom:1px solid #E7E2DA;">'+t+'</div>'; }
  function statBox(n,l){ return '<div style="flex:1; min-width:110px; border:1px solid #E7E2DA; border-radius:8px; padding:12px; text-align:center;"><div style="font-size:22px; font-weight:800;">'+n+'</div><div style="font-size:11.5px; color:#8A857C; margin-top:3px;">'+l+'</div></div>'; }
  function table(title, rows, leftHead, rightHead){
    return sectionTitle(title) + '<table style="width:100%; border-collapse:collapse; font-size:12.5px;">'+
      '<tr><th style="text-align:right; padding:6px 8px; border-bottom:2px solid #E7E2DA; color:#8A857C;">'+leftHead+'</th><th style="text-align:center; padding:6px 8px; border-bottom:2px solid #E7E2DA; color:#8A857C; width:90px;">'+rightHead+'</th></tr>'+
      (rows || '<tr><td colspan="2" style="text-align:center; padding:14px; color:#8A857C;">لا توجد بيانات</td></tr>')+
    '</table>';
  }

  s += sectionTitle('نظرة عامة');
  s += '<div style="display:flex; gap:10px; flex-wrap:wrap;">'+
    statBox(cases.length,'إجمالي الحالات')+statBox(open,'حالات مفتوحة')+statBox(closed,'حالات مغلقة')+
    statBox(remOverdue,'تذكيرات متأخرة')+statBox(remToday,'تذكيرات اليوم')+statBox(remUpcoming,'تذكيرات قادمة')+statBox(remDone,'تذكيرات مكتملة')+
  '</div>';

  s += table('توزيع الحالات حسب Status', reportTableRows_(byStatus), 'Status', 'العدد');
  s += table('توزيع الحالات حسب Priority', reportTableRows_(byPriority), 'Priority', 'العدد');
  s += table('توزيع الحالات حسب Category', reportTableRows_(byCategory), 'Category', 'العدد');
  s += table('توزيع الحالات حسب Problem Type', reportTableRows_(byProblemType), 'Problem Type', 'العدد');
  s += table('أداء الموظفين (عدد الحالات المسجّلة لكل موظف)', reportTableRows_(byEmployee), 'الموظف', 'العدد');

  s += sectionTitle('آخر العمليات في سجل Audit Log (حتى 25 عملية)');
  s += '<table style="width:100%; border-collapse:collapse; font-size:11.5px;">'+
    '<tr><th style="text-align:right; padding:6px 8px; border-bottom:2px solid #E7E2DA; color:#8A857C;">الوقت</th><th style="text-align:right; padding:6px 8px; border-bottom:2px solid #E7E2DA; color:#8A857C;">المستخدم</th><th style="text-align:right; padding:6px 8px; border-bottom:2px solid #E7E2DA; color:#8A857C;">العملية</th><th style="text-align:right; padding:6px 8px; border-bottom:2px solid #E7E2DA; color:#8A857C;">Case ID</th></tr>'+
    auditRows.slice(0,25).map(function(l){
      return '<tr><td style="padding:5px 8px; border-bottom:1px solid #F1EEE8;">'+esc(new Date(l.Timestamp).toLocaleString('ar-EG-u-nu-latn'))+'</td><td style="padding:5px 8px; border-bottom:1px solid #F1EEE8;">'+esc(l.Username)+'</td><td style="padding:5px 8px; border-bottom:1px solid #F1EEE8;">'+esc(l.ActionType)+'</td><td style="padding:5px 8px; border-bottom:1px solid #F1EEE8;">'+esc(l.CaseID||'—')+'</td></tr>';
    }).join('') +
  '</table>';

  s += '<div style="margin-top:24px; font-size:10.5px; color:#8A857C; text-align:center;">تقرير سري — للاستخدام الإداري الداخلي فقط • National Bird Telecom Back Office</div>';
  s += '</div>';
  return s;
}
function generatePdfReport(){
  if (STATE.role !== 'admin'){ toast('هذه العملية تتطلب صلاحية Admin', 'err'); return; }
  var btn = $('genReportBtn'); btn.disabled = true; btn.textContent = 'جارِ تجهيز التقرير...';
  api('adminGetAuditLog').then(function(res){
    var holder = document.createElement('div');
    holder.style.position = 'fixed'; holder.style.top = '-99999px'; holder.style.left = '0';
    holder.innerHTML = buildReportHtml_(res.log || []);
    document.body.appendChild(holder);
    var target = holder.firstElementChild;
    return html2canvas(target, { scale: 2, backgroundColor: '#ffffff' }).then(function(canvas){
      document.body.removeChild(holder);
      var jsPDFCtor = window.jspdf.jsPDF;
      var pdf = new jsPDFCtor('p', 'mm', 'a4');
      var pageWmm = 210, pageHmm = 297;
      var imgWmm = pageWmm;
      var imgHmm = canvas.height * imgWmm / canvas.width;
      var heightLeftMm = imgHmm;
      var position = 0;
      var imgData = canvas.toDataURL('image/png');
      pdf.addImage(imgData, 'PNG', 0, position, imgWmm, imgHmm);
      heightLeftMm -= pageHmm;
      while (heightLeftMm > 0){
        position = heightLeftMm - imgHmm;
        pdf.addPage();
        pdf.addImage(imgData, 'PNG', 0, position, imgWmm, imgHmm);
        heightLeftMm -= pageHmm;
      }
      pdf.save('BackOffice_Report_' + new Date().toISOString().slice(0,10) + '.pdf');
      toast('تم توليد التقرير بنجاح', 'ok');
    });
  }).catch(function(err){ toast(err.message, 'err'); })
  .finally(function(){ btn.disabled=false; btn.textContent='📄 توليد وتنزيل تقرير PDF'; });
}
